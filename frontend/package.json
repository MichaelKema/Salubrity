{
  "name": "salubrity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/nutrition.test.ts && vitest run",
    "tauri": "tauri",
    "test:ui": "vitest run",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "build:desktop-assets": "npm run prepare:backend && npm run build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app && node scripts/package-dmg.mjs",
    "collect:notices": "python3 scripts/collect-notices.py"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "license": "MIT"
}
